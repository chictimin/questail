{
  "name": "@questail/web",
  "version": "0.1.0",
  "private": true,
  "description": "QuestTail web app — local-first library archive (R1 bootstrap: health server only)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "tsc && vite build && vitest run && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "vite build && playwright test",
    "test:perf": "vite build && playwright test --config playwright.perf.config.ts",
    "build:ui": "vite build",
    "start": "node dist/src/server/run.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@phosphor-icons/react": "2.1.10",
    "@questail/core": "workspace:*",
    "@tanstack/react-virtual": "3.14.13",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
